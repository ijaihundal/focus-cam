# ---- Focus Cam configuration ----
# Copy this file to ".env" and fill in your values.
# NEVER commit your real .env (it's gitignored).

# Username to log in with
AUTH_USERNAME=admin

# Option A (simple): plain-text password. Compared with constant-time compare.
AUTH_PASSWORD=change-me

# Option B (more secure): bcrypt hash. If set, this is used instead of AUTH_PASSWORD.
# Generate one with:  node hash.js "your-password"
# AUTH_PASSWORD_HASH=$2a$10$.......

# Secret used to sign session cookies. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Set to "production" behind HTTPS (Dokploy). Cookies become HTTPS-only.
NODE_ENV=production

# Optional: override port/host
# PORT=3000
# HOST=0.0.0.0
